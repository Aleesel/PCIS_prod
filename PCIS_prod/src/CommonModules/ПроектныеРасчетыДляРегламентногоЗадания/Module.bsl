///Модуль "ПроектныеРасчетыДляРегламентногоЗадания"
///Для регламентного задания по пересчету статусов/дат/процентов

&НаСервере
Процедура ОбновитьВсеСтатусы() Экспорт
    
    Сообщить("Начало регламентного пересчёта статусов");
    
    ОбновитьВсеЗадачи();
    ОбновитьВсеЭтапы();
    ОбновитьВсеПроекты();
    
    Сообщить("Регламентный пересчёт завершён");
    
КонецПроцедуры

&НаСервере
Процедура ОбновитьВсеЗадачи()
    
    Сообщить("Обновление всех задач...");
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   Задачи.Ссылка
    |ИЗ
    |   Справочник.Задача КАК Задачи";
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    Пока Выборка.Следующий() Цикл
        ПроектныеРасчеты.ПересчитатьЗадачу(Выборка.Ссылка);
    КонецЦикла;
    
    Сообщить("Задачи обновлены");
    
КонецПроцедуры

