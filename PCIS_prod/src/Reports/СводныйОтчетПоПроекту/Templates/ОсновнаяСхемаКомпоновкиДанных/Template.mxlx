<?xml version="1.0" encoding="UTF-8"?>
<TemplateExtension xmlns="http://v8.1c.ru/8.3/xcf/extrnprops" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema">
		<dataSource>
			<name>ИсточникДанных1</name>
			<dataSourceType>Local</dataSourceType>
		</dataSource>
		<dataSet xsi:type="DataSetQuery">
			<name>НаборДанных1</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Проект</dataPath>
				<field>Проект</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ПланДатаНачала</dataPath>
				<field>ПланДатаНачала</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ПланДатаОкончания</dataPath>
				<field>ПланДатаОкончания</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>СтатусВыполнения</dataPath>
				<field>СтатусВыполнения</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ПроцентВыполнения</dataPath>
				<field>ПроцентВыполнения</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ФактДатаНачала</dataPath>
				<field>ФактДатаНачала</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ФактДатаОкончания</dataPath>
				<field>ФактДатаОкончания</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>КолвоЭтапов</dataPath>
				<field>КолвоЭтапов</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>КолвоЗадач</dataPath>
				<field>КолвоЗадач</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>КолвоПросроченных</dataPath>
				<field>КолвоПросроченных</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>КолвоРисков</dataPath>
				<field>КолвоРисков</field>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	Проект.Ссылка КАК Проект,
	Проект.Наименование КАК Наименование,
	Проект.ПланДатаНачала КАК ПланДатаНачала,
	Проект.ПланДатаОкончания КАК ПланДатаОкончания,
	ЕСТЬNULL(ХодПроекта.СтатусВыполнения, ""Запланирован"") КАК СтатусВыполнения,
	ЕСТЬNULL(ХодПроекта.ПроцентВыполнения, 0) КАК ПроцентВыполнения,
	ХодПроекта.ФактДатаНачала КАК ФактДатаНачала,
	ХодПроекта.ФактДатаОкончания КАК ФактДатаОкончания,
	ЕСТЬNULL(Этапы.КолвоЭтапов, 0) КАК КолвоЭтапов,
	ЕСТЬNULL(Задачи.КолвоЗадач, 0) КАК КолвоЗадач,
	ЕСТЬNULL(Просроченные.КолвоПросроченных, 0) КАК КолвоПросроченных,
	ЕСТЬNULL(Риски.КолвоРисков, 0) КАК КолвоРисков
ИЗ
	Справочник.Проект КАК Проект
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХодВыполненияПроекта КАК ХодПроекта
			ПО Проект.Ссылка = ХодПроекта.Проект
		ЛЕВОЕ СОЕДИНЕНИЕ (
			ВЫБРАТЬ Этап.Владелец КАК Проект, КОЛИЧЕСТВО(Этап.Ссылка) КАК КолвоЭтапов
			ИЗ Справочник.Этап КАК Этап
			ГДЕ НЕ Этап.ПометкаУдаления
			СГРУППИРОВАТЬ ПО Этап.Владелец
		) КАК Этапы ПО Проект.Ссылка = Этапы.Проект
		ЛЕВОЕ СОЕДИНЕНИЕ (
			ВЫБРАТЬ Задача.Этап.Владелец КАК Проект, КОЛИЧЕСТВО(Задача.Ссылка) КАК КолвоЗадач
			ИЗ Справочник.Задача КАК Задача
			ГДЕ НЕ Задача.ПометкаУдаления
			СГРУППИРОВАТЬ ПО Задача.Этап.Владелец
		) КАК Задачи ПО Проект.Ссылка = Задачи.Проект
		ЛЕВОЕ СОЕДИНЕНИЕ (
			ВЫБРАТЬ Задача.Этап.Владелец КАК Проект, КОЛИЧЕСТВО(Задача.Ссылка) КАК КолвоПросроченных
			ИЗ Справочник.Задача КАК Задача
			ГДЕ НЕ Задача.ПометкаУдаления
				И Задача.СтатусВыполнения &lt;&gt; ""Завершена""
				И Задача.ПланДатаОкончания &lt; &amp;ТекущаяДата
			СГРУППИРОВАТЬ ПО Задача.Этап.Владелец
		) КАК Просроченные ПО Проект.Ссылка = Просроченные.Проект
		ЛЕВОЕ СОЕДИНЕНИЕ (
			ВЫБРАТЬ Риск.Проект КАК Проект, КОЛИЧЕСТВО(Риск.НаименованиеРиска) КАК КолвоРисков
			ИЗ РегистрСведений.РискиПроекта КАК Риск
			СГРУППИРОВАТЬ ПО Риск.Проект
		) КАК Риски ПО Проект.Ссылка = Риски.Проект
ГДЕ
	НЕ Проект.ПометкаУдаления</query>
		<parameters>
			<name>ТекущаяДата</name>
			<title>Текущая дата</title>
			<valueType xmlns:v8="http://v8.1c.ru/8.1/data/core" xsi:type="v8:DateQualifiers"><dateFractions>Date</dateFractions></valueType>
		</parameters>
		</dataSet>
		<dcsset:settingsVariant xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings">
			<dcsset:name>Основной</dcsset:name>
			<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
			<dcsset:settings xmlns:pal="http://v8.1c.ru/8.1/data/ui/colors/palette" xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>Проект</dcsset:field>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>Наименование</dcsset:field>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>ПланДатаНачала</dcsset:field>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>ПланДатаОкончания</dcsset:field>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>СтатусВыполнения</dcsset:field>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>ПроцентВыполнения</dcsset:field>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>ФактДатаНачала</dcsset:field>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>ФактДатаОкончания</dcsset:field>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>КолвоЭтапов</dcsset:field>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>КолвоЗадач</dcsset:field>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>КолвоПросроченных</dcsset:field>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:SelectedItemField">
						<dcsset:field>КолвоРисков</dcsset:field>
					</dcsset:item>
				</dcsset:selection>
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemField">
						<dcsset:field>Проект</dcsset:field>
						<dcsset:orderType>Asc</dcsset:orderType>
					</dcsset:item>
				</dcsset:order>
				<dcsset:outputParameters>
					<dcsset:item xsi:type="dcsset:SettingsParameterValue">
						<dcsset:parameter>РасположениеИтогов</dcsset:parameter>
						<dcsset:value xsi:type="dcscor:DataCompositionTotalPlacement">None</dcsset:value>
					</dcsset:item>
				</dcsset:outputParameters>
				<dcsset:item xsi:type="dcsset:StructureItemTable">
					<dcsset:column>
						<dcsset:groupItems>
							<dcsset:item xsi:type="dcsset:GroupItemField">
								<dcsset:field>СтатусВыполнения</dcsset:field>
								<dcsset:groupType>Items</dcsset:groupType>
								<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
								<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
								<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
							</dcsset:item>
						</dcsset:groupItems>
						<dcsset:order>
							<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
						</dcsset:order>
						<dcsset:selection>
							<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
						</dcsset:selection>
					</dcsset:column>
					<dcsset:column>
						<dcsset:groupItems>
							<dcsset:item xsi:type="dcsset:GroupItemField">
								<dcsset:field>ПроцентВыполнения</dcsset:field>
								<dcsset:groupType>Items</dcsset:groupType>
								<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
								<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
								<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
							</dcsset:item>
						</dcsset:groupItems>
						<dcsset:order>
							<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
						</dcsset:order>
						<dcsset:selection>
							<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
						</dcsset:selection>
					</dcsset:column>
					<dcsset:row>
						<dcsset:groupItems>
							<dcsset:item xsi:type="dcsset:GroupItemField">
								<dcsset:field>Проект</dcsset:field>
								<dcsset:groupType>Items</dcsset:groupType>
								<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
								<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
								<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
							</dcsset:item>
						</dcsset:groupItems>
						<dcsset:order>
							<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
						</dcsset:order>
						<dcsset:selection>
							<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
						</dcsset:selection>
					</dcsset:row>
				</dcsset:item>
			</dcsset:settings>
		</dcsset:settingsVariant>
	</DataCompositionSchema>
</TemplateExtension>