///Модуль объекта справочника "Этап"

Процедура ПриЗаписи(Отказ, РежимЗаписи, РежимПроведения)        Если НЕ ЗначениеЗаполнено(ПланДатаНачала) Или НЕ ЗначениеЗаполнено(ПланДатаОкончания) Тогда        Возврат;    КонецЕсли;        Если ПланДатаНачала > ПланДатаОкончания Тогда        Отказ = Истина;        Сообщить("Ошибка: план дата начала не может быть позже даты окончания");        Возврат;    КонецЕсли;        Если НЕ ЗначениеЗаполнено(Владелец) Тогда        Возврат;    КонецЕсли;        ПроектОбъект = Владелец.ПолучитьОбъект();    Если ПроектОбъект = Неопределено Тогда        Возврат;    КонецЕсли;        Если ЗначениеЗаполнено(ПроектОбъект.ПланДатаНачала) И ПланДатаНачала < ПроектОбъект.ПланДатаНачала Тогда        Отказ = Истина;        Сообщить("Ошибка: план дата начала этапа не может быть раньше даты начала проекта");        Возврат;    КонецЕсли;        Если ЗначениеЗаполнено(ПроектОбъект.ПланДатаОкончания) И ПланДатаОкончания > ПроектОбъект.ПланДатаОкончания Тогда        Отказ = Истина;        Сообщить("Ошибка: план дата окончания этапа не может быть позже даты окончания проекта");        Возврат;    КонецЕсли;    	Запрос = Новый Запрос;	Запрос.Текст =	"ВЫБРАТЬ ПЕРВЫЕ 1	|   Задача.Ссылка	|ИЗ	|   Справочник.Задача КАК Задача	|ГДЕ	|   Задача.Владелец = &Этап";		Запрос.УстановитьПараметр("Этап", Ссылка);		Если Запрос.Выполнить().Пустой() Тогда	    Возврат;	КонецЕсли;		Запрос = Новый Запрос;	Запрос.Текст =	"ВЫБРАТЬ	|   Задача.ПланДатаНачала,	|   Задача.ПланДатаОкончания	|ИЗ	|   Справочник.Задача КАК Задача	|ГДЕ	|   Задача.Владелец = &Этап";		Запрос.УстановитьПараметр("Этап", Ссылка);	Выборка = Запрос.Выполнить().Выбрать();		Пока Выборка.Следующий() Цикл	    Если ЗначениеЗаполнено(Выборка.ПланДатаНачала) И Выборка.ПланДатаНачала < ПланДатаНачала Тогда	        Отказ = Истина;	        Сообщить("Ошибка: план дата начала этапа не может быть позже даты начала задачи");	        Возврат;	    КонецЕсли;	    	    Если ЗначениеЗаполнено(Выборка.ПланДатаОкончания) И Выборка.ПланДатаОкончания > ПланДатаОкончания Тогда	        Отказ = Истина;	        Сообщить("Ошибка: план дата окончания этапа не может быть раньше даты окончания задачи");	        Возврат;	    КонецЕсли;	КонецЦикла;    КонецПроцедуры