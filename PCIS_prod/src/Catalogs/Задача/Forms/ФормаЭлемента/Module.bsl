///Модуль формы справочника "Задача"&НаКлиентеПроцедура ПередЗаписью(Отказ, ПараметрыЗаписи)        Сообщить("ФОРМА.ПередЗаписью");        // Проверяем обязательные поля    Если НЕ ЗначениеЗаполнено(Объект.Владелец) Тогда        Сообщить("Владелец (Этап) не выбран!");        Отказ = Истина;        Возврат;    КонецЕсли;        Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда        Сообщить("Наименование не заполнено!");        Отказ = Истина;        Возврат;    КонецЕсли;        Если НЕ ЗначениеЗаполнено(Объект.ПланДатаНачала) Тогда        Сообщить("План дата начала не заполнена!");        Отказ = Истина;        Возврат;    КонецЕсли;        Если НЕ ЗначениеЗаполнено(Объект.ПланДатаОкончания) Тогда        Сообщить("План дата окончания не заполнена!");        Отказ = Истина;        Возврат;    КонецЕсли;        Сообщить("Поля заполнены корректно");    КонецПроцедуры&НаКлиентеПроцедура ПослеЗаписи(ПараметрыЗаписи)        Сообщить("ФОРМА.ПослеЗаписи");    Сообщить("Ссылка: " + Объект.Ссылка);        // Запускаем пересчёт    ПроектныеРасчетыКлиент.ОбновитьПоЗадаче(Объект.Ссылка);        Сообщить("Пересчёт завершён");    КонецПроцедуры