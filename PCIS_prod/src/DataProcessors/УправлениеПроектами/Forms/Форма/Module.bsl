&НаСервереПроцедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	// Инициализация при открытии формы	ТекущееСостояние = "ГруппаСписокПроектов";		// Инициализируем таблицы	ТаблицаПроектов.Очистить();	ТаблицаЗадач.Очистить();	ДанныеДиаграммы.Очистить();		// УПРАВЛЯЕМ ВИДИМОСТЬЮ ГРУПП	Элементы.ГруппаСписокПроектов.Видимость = Истина;	Элементы.Главная.Видимость = Ложь;	Элементы.Задачи.Видимость = Ложь;	Элементы.ГруппаКарточкаЗадачи.Видимость = Ложь;	Элементы.Риски.Видимость = Ложь;	Элементы.Команда.Видимость = Ложь;	Элементы.ГруппаОтчеты.Видимость = Ложь;		// Загружаем список проектов	ОбновитьСписокПроектовНаСервере();		Сообщить("Форма инициализирована. Проектов загружено: " + ТаблицаПроектов.Количество());КонецПроцедуры// ==================== ПЕРЕКЛЮЧЕНИЕ СТРАНИЦ ====================&НаКлиентеПроцедура ПереключитьСтраницу(ИмяГруппы)	ПереключитьСтраницуНаСервере(ИмяГруппы);		// Если открыли Главную группу - заполняем Гант с небольшой задержкой	Если ИмяГруппы = "Главная" Тогда		ПодключитьОбработчикОжидания("ЗаполнитьГантНаКлиентеОжидание", 1, Истина);	КонецЕсли;КонецПроцедуры&НаКлиентеПроцедура ЗаполнитьГантНаКлиентеОжидание()	ОтключитьОбработчикОжидания("ЗаполнитьГантНаКлиентеОжидание");	ЗаполнитьГантНаКлиенте();КонецПроцедуры&НаСервереПроцедура ПереключитьСтраницуНаСервере(ИмяГруппы)	// Скрываем все группы	Элементы.ГруппаСписокПроектов.Видимость = Ложь;	Элементы.Главная.Видимость = Ложь;	Элементы.Задачи.Видимость = Ложь;	Элементы.ГруппаКарточкаЗадачи.Видимость = Ложь;	Элементы.Риски.Видимость = Ложь;	Элементы.Команда.Видимость = Ложь;	Элементы.ГруппаОтчеты.Видимость = Ложь;		// Показываем целевую группу	Попытка		Элементы[ИмяГруппы].Видимость = Истина;		ТекущееСостояние = ИмяГруппы;	Исключение		Сообщить("Группа не найдена: " + ИмяГруппы);		Возврат;	КонецПопытки;		// Загружаем данные для соответствующей группы	Если ИмяГруппы = "ГруппаСписокПроектов" Тогда		ОбновитьСписокПроектовНаСервере();			ИначеЕсли ИмяГруппы = "Главная" Тогда		Если НЕ ЗначениеЗаполнено(ТекущийПроект) Тогда			Сообщить("⚠ Пожалуйста, сначала выберите проект!");			Возврат;		КонецЕсли;		ОбновитьТаблицуЗадачНаСервере();		ПостроитьДиаграммуГанта();		Сообщить("✓ Данные загружены. На странице 'Задачи' вы можете увидеть все задачи проекта с датами и прогрессом.");			ИначеЕсли ИмяГруппы = "Задачи" Тогда		Если НЕ ЗначениеЗаполнено(ТекущийПроект) Тогда			Сообщить("⚠ Пожалуйста, сначала выберите проект!");			Возврат;		КонецЕсли;		ОбновитьТаблицуЗадачНаСервере();	КонецЕсли;КонецПроцедуры// ==================== КНОПКИ НАВИГАЦИИ (на клиенте) ====================&НаКлиентеПроцедура КомандаМенюГлавная(Команда)	ПереключитьСтраницу("Главная");КонецПроцедуры&НаКлиентеПроцедура КомандаМенюНазад(Команда)	ПереключитьСтраницу("ГруппаСписокПроектов");КонецПроцедуры&НаКлиентеПроцедура КомандаМенюЗадачи(Команда)	ПереключитьСтраницу("Задачи");КонецПроцедуры&НаКлиентеПроцедура КомандаМенюПроекты(Команда)	ПереключитьСтраницу("ГруппаСписокПроектов");КонецПроцедуры&НаКлиентеПроцедура КомандаМенюКоманда(Команда)	ПереключитьСтраницу("Команда");КонецПроцедуры&НаКлиентеПроцедура КомандаМенюРиски(Команда)	ПереключитьСтраницу("Риски");КонецПроцедуры&НаКлиентеПроцедура КомандаМенюОтчеты(Команда)	ПереключитьСтраницу("ГруппаОтчеты");КонецПроцедуры// ==================== ЗАГРУЗКА ДАННЫХ ====================&НаСервереПроцедура ОбновитьСписокПроектовНаСервере()	Попытка		ТаблицаПроектов.Очистить();				Запрос = Новый Запрос;		Запрос.Текст = 			"ВЫБРАТЬ			|	Проект.Ссылка КАК Ссылка,			|	Проект.Наименование КАК Наименование,			|	Проект.ПланДатаНачала КАК ДатаНачала,			|	Проект.ПланДатаОкончания КАК ДатаОкончания			|ИЗ			|	Справочник.Проект КАК Проект			|ГДЕ			|	НЕ Проект.ПометкаУдаления			|УПОРЯДОЧИТЬ ПО			|	Проект.Наименование";				РезультатЗапроса = Запрос.Выполнить();				Если НЕ РезультатЗапроса.Пустой() Тогда			ТаблицаПроектов.Загрузить(РезультатЗапроса.Выгрузить());			Сообщить("✓ Проекты загружены: " + ТаблицаПроектов.Количество());		Иначе			Сообщить("⚠ Проектов не найдено в справочнике 'Проект'");		КонецЕсли;	Исключение		Сообщить("✗ Ошибка загрузки проектов: " + ОписаниеОшибки());	КонецПопытки;КонецПроцедуры&НаСервереПроцедура ОбновитьТаблицуЗадачНаСервере()	Попытка		ТаблицаЗадач.Очистить();				Если НЕ ЗначениеЗаполнено(ТекущийПроект) Тогда			Сообщить("⚠ Проект не выбран");			Возврат;		КонецЕсли;				Запрос = Новый Запрос;		Запрос.Текст = 			"ВЫБРАТЬ			|	ЗадачаДан.Ссылка КАК Ссылка,			|	ЗадачаДан.Наименование КАК Наименование,			|	ЗадачаДан.Владелец КАК ЭтапСсылка,			|	ЭтапДан.Наименование КАК НаименованиеЭтапа,			|	ЗадачаДан.ПланДатаНачала КАК ПланДатаНачала,			|	ЗадачаДан.ПланДатаОкончания КАК ПланДатаОкончания,			|	ЕСТЬNULL(ХодЗадачи.ПроцентВыполнения, 0) КАК ПроцентВыполнения,			|	ЕСТЬNULL(ХодЗадачи.СтатусВыполнения, ""Запланирована"") КАК Статус			|ИЗ			|	Справочник.Задача КАК ЗадачаДан			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Этап КАК ЭтапДан			|			ПО ЗадачаДан.Владелец = ЭтапДан.Ссылка			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХодВыполненияЗадачи КАК ХодЗадачи			|			ПО ЗадачаДан.Ссылка = ХодЗадачи.Задача			|ГДЕ			|	ЭтапДан.Владелец = &ПроектПарам			|	И НЕ ЗадачаДан.ПометкаУдаления";				Запрос.УстановитьПараметр("ПроектПарам", ТекущийПроект);		РезультатЗапроса = Запрос.Выполнить();				Если НЕ РезультатЗапроса.Пустой() Тогда			ТаблицаЗадач.Загрузить(РезультатЗапроса.Выгрузить());			Сообщить("✓ Задачи загружены: " + ТаблицаЗадач.Количество());		Иначе			Сообщить("⚠ Задач не найдено для проекта");		КонецЕсли;	Исключение		Сообщить("✗ Ошибка загрузки задач: " + ОписаниеОшибки());	КонецПопытки;КонецПроцедуры// ==================== ДИАГРАММА ГАНТА ====================&НаСервереПроцедура ПостроитьДиаграммуГанта()	Попытка		Если НЕ ЗначениеЗаполнено(ТекущийПроект) Тогда			Сообщить("⚠ Проект не выбран");			Возврат;		КонецЕсли;				// Очищаем данные диаграммы		ДанныеДиаграммы.Очистить();				Запрос = Новый Запрос;		Запрос.Текст = 			"ВЫБРАТЬ			|	ЗадачаДан.Ссылка КАК Ссылка,			|	ЗадачаДан.Наименование КАК Наименование,			|	ЗадачаДан.ПланДатаНачала КАК ДатаНачала,			|	ЗадачаДан.ПланДатаОкончания КАК ДатаОкончания,			|	ЭтапДан.Наименование КАК НаименованиеЭтапа,			|	ЕСТЬNULL(ХодЗадачи.ПроцентВыполнения, 0) КАК ПроцентВыполнения			|ИЗ			|	Справочник.Задача КАК ЗадачаДан			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Этап КАК ЭтапДан			|			ПО ЗадачаДан.Владелец = ЭтапДан.Ссылка			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХодВыполненияЗадачи КАК ХодЗадачи			|			ПО ЗадачаДан.Ссылка = ХодЗадачи.Задача			|ГДЕ			|	ЭтапДан.Владелец = &ПроектПарам			|	И НЕ ЗадачаДан.ПометкаУдаления			|УПОРЯДОЧИТЬ ПО			|	ЗадачаДан.ПланДатаНачала";				Запрос.УстановитьПараметр("ПроектПарам", ТекущийПроект);		Результат = Запрос.Выполнить().Выбрать();				Пока Результат.Следующий() Цикл			НоваяСтрока = ДанныеДиаграммы.Добавить();			НоваяСтрока.Наименование = Результат.Наименование;			НоваяСтрока.ДатаНачала = Результат.ДатаНачала;			НоваяСтрока.ДатаОкончания = Результат.ДатаОкончания;			НоваяСтрока.НаименованиеЭтапа = Результат.НаименованиеЭтапа;						// СОХРАНЯЕМ ПРОЦЕНТ КАК ЧИСЛО			Процент = Результат.ПроцентВыполнения;			НоваяСтрока.ПроцентВыполнения = Процент;						// ВИЗУАЛИЗАЦИЯ: преобразуем процент в звёздочки			КоличествоЗвезд = Окр(Процент / 20, 0); // 5 звёзд за 100%						Визуализация = "";			Для i = 1 По КоличествоЗвезд Цикл				Визуализация = Визуализация + "★";			КонецЦикла;			Для i = КоличествоЗвезд По 4 Цикл				Визуализация = Визуализация + "☆";			КонецЦикла;						НоваяСтрока.ПрогрессВизуализация = Визуализация;		КонецЦикла;				Сообщить("✓ Таблица задач с процентом выполнения подготовлена. Строк: " + ДанныеДиаграммы.Количество());	Исключение		Сообщить("✗ Ошибка построения таблицы: " + ОписаниеОшибки());	КонецПопытки;КонецПроцедуры&НаКлиентеПроцедура ГлавнаяПриАктивизации(Элемент)	// Заполняем Гант при активации группы Главная	ЗаполнитьГантНаКлиенте();КонецПроцедуры// ==================== ЗАПОЛНЕНИЕ ГАНТА ====================&НаКлиентеПроцедура ЗаполнитьГантНаКлиенте()	Попытка		Сообщить("✓ Данные Ганта подготовлены. Таблица задач содержит: " + ДанныеДиаграммы.Количество() + " элементов");	Исключение		Сообщить("✗ Ошибка: " + ОписаниеОшибки());	КонецПопытки;КонецПроцедуры// ==================== ВЫБОР ПРОЕКТА ====================&НаКлиентеПроцедура ТаблицаПроектовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)	СтандартнаяОбработка = Ложь;	Данные = Элемент.ТекущиеДанные;		Если Данные <> Неопределено И Данные.Ссылка <> Неопределено Тогда		ТекущийПроект = Данные.Ссылка;		ОбновитьШапкуПроекта();		Сообщить("✓ Выбран проект: " + Данные.Наименование);		ПереключитьСтраницу("Главная");	КонецЕсли;КонецПроцедуры&НаСервереПроцедура ОбновитьШапкуПроекта()	Если ЗначениеЗаполнено(ТекущийПроект) Тогда		Попытка			ШапкаПроекта = ТекущийПроект.Наименование;		Исключение			ШапкаПроекта = "Проект";		КонецПопытки;	Иначе		ШапкаПроекта = "Проект не выбран";	КонецЕсли;КонецПроцедуры// ==================== ОБРАБОТКА ЗАДАЧ ====================&НаКлиентеПроцедура ТаблицаЗадачВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)	СтандартнаяОбработка = Ложь;	Данные = Элемент.ТекущиеДанные;		Если Данные <> Неопределено И Данные.Ссылка <> Неопределено Тогда		ТекущаяЗадача = Данные.Ссылка;		ПереключитьСтраницу("ГруппаКарточкаЗадачи");		ОбновитьКарточкуЗадачи();	КонецЕсли;КонецПроцедуры&НаСервереПроцедура ОбновитьКарточкуЗадачи()	Если ЗначениеЗаполнено(ТекущаяЗадача) Тогда		Попытка			ЗадачаНаименование = ТекущаяЗадача.Наименование;			ЗадачаПланНачало = ТекущаяЗадача.ПланДатаНачала;			ЗадачаПланОкончание = ТекущаяЗадача.ПланДатаОкончания;			ЗадачаПроцент = 0;			ЗадачаСтатус = "Запланирована";						Сообщить("✓ Карточка задачи загружена");		Исключение			Сообщить("✗ Ошибка загрузки задачи: " + ОписаниеОшибки());		КонецПопытки;	КонецЕсли;КонецПроцедуры// ==================== СОХРАНЕНИЕ ЗАДАЧИ ====================&НаКлиентеПроцедура КнопкаСохранитьЗадачу(Команда)	СохранитьЗадачуНаСервере();КонецПроцедуры&НаСервере
Процедура СохранитьЗадачуНаСервере()
	Если ЗначениеЗаполнено(ТекущаяЗадача) Тогда
		Попытка
			ОбъектЗадачи = ТекущаяЗадача.ПолучитьОбъект();
			ОбъектЗадачи.Наименование = ЗадачаНаименование;
			ОбъектЗадачи.ПланДатаНачала = ЗадачаПланНачало;
			ОбъектЗадачи.ПланДатаОкончания = ЗадачаПланОкончание;
			ОбъектЗадачи.Написать();
			
			ПроектныеРасчеты.ОбновитьПоЗадаче(ТекущаяЗадача);
			
			Сообщить("✓ Задача сохранена");
			ОбновитьТаблицуЗадачНаСервере();
		Исключение
			Сообщить("✗ Ошибка сохранения задачи: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// ==================== ГРУППА "ЭТАПЫ" ====================

&НаСервере
Процедура ОбновитьТаблицуЭтаповНаСервере()
	Попытка
		ТаблицаЭтапов.Очистить();
		
		Если НЕ ЗначениеЗаполнено(ТекущийПроект) Тогда
			Сообщить("⚠ Проект не выбран");
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЭтапДан.Ссылка КАК Ссылка,
			|	ЭтапДан.Наименование КАК Наименование,
			|	ЭтапДан.ЦветЭтапа КАК ЦветЭтапа,
			|	ЭтапДан.ПланДатаНачала КАК ПланДатаНачала,
			|	ЭтапДан.ПланДатаОкончания КАК ПланДатаОкончания,
			|	ЕСТЬNULL(ХодЭтапа.ПроцентВыполнения, 0) КАК ПроцентВыполнения,
			|	ЕСТЬNULL(ХодЭтапа.СтатусВыполнения, ""Запланирован"") КАК Статус,
			|	ХодЭтапа.ФактДатаНачала КАК ФактДатаНачала,
			|	ХодЭтапа.ФактДатаОкончания КАК ФактДатаОкончания
			|ИЗ
			|	Справочник.Этап КАК ЭтапДан
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХодВыполненияЭтапа КАК ХодЭтапа
			|			ПО ЭтапДан.Ссылка = ХодЭтапа.Этап
			|ГДЕ
			|	ЭтапДан.Владелец = &ПроектПарам
			|	И НЕ ЭтапДан.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	ЭтапДан.ПланДатаНачала";
		
		Запрос.УстановитьПараметр("ПроектПарам", ТекущийПроект);
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ТаблицаЭтапов.Загрузить(РезультатЗапроса.Выгрузить());
			Сообщить("✓ Этапы загружены: " + ТаблицаЭтапов.Количество());
		Иначе
			Сообщить("⚠ Этапов не найдено для проекта");
		КонецЕсли;
	Исключение
		Сообщить("✗ Ошибка загрузки этапов: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЭтаповВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Данные = Элемент.ТекущиеДанные;
	
	Если Данные <> Неопределено И Данные.Ссылка <> Неопределено Тогда
		ТекущийЭтап = Данные.Ссылка;
