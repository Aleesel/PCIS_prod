					|ИЗ
					|	РегистрСведений.ВехиПроекта КАК Веха
					|ГДЕ
					|	Веха.Проект = &Проект
					|	И Веха.НаименованиеВехи = &Наименование";
				Запрос.УстановитьПараметр("Проект", ТекущийПроект);
				Запрос.УстановитьПараметр("Наименование", Стр.НаименованиеВехи);
				Результат = Запрос.Выполнить();
				
				Запись = РегистрыСведений.ВехиПроекта.СоздатьМенеджерЗаписи();
				Запись.Проект = ТекущийПроект;
				Запись.НаименованиеВехи = Стр.НаименованиеВехи;
				Запись.Статус = Стр.Статус;
				Запись.Записать();
			КонецЕсли;
		КонецЦикла;
		
		ПроектныеРасчеты.ПересчитатьПроект(ТекущийПроект);
		
		Сообщить("✓ Проект сохранен");
		ОбновитьКарточкуПроектаНаСервере();
	Исключение
		Сообщить("✗ Ошибка сохранения проекта: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

